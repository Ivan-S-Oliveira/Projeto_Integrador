# =========================================================
# Ambiente virtual
# =========================================================

.venv/
venv/
env/


# =========================================================
# Python
# =========================================================

__pycache__/
*.py[cod]
*$py.class
*.egg-info/


# =========================================================
# Jupyter
# =========================================================

.ipynb_checkpoints/


# =========================================================
# Dados
# =========================================================

data/raw/*
data/processed/*
data/analytical/*
data/treino/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/analytical/.gitkeep
!data/treino/.gitkeep
*.parquet


# =========================================================
# Modelos treinados
# =========================================================

models/*.pkl
models/*.joblib
models/*.pickle
models/*.h5
models/*.pt
models/*.pth

!models/.gitkeep


# =========================================================
# Resultados
# =========================================================

*.log
*.tmp

reports/figures/*
reports/resultados/*

!reports/figures/.gitkeep
!reports/resultados/.gitkeep


# =========================================================
# Variáveis de ambiente
# =========================================================

.env
.env.*
!.env.example


# =========================================================
# Sistema operacional
# =========================================================

.DS_Store
Thumbs.db


# =========================================================
# IDEs
# =========================================================

.vscode/
.idea/

# Configurações específicas de cada computador
configs/paths.local.json


# =========================================================
# Artefatos gerados pelas execuções
# =========================================================

outputs/*
!outputs/.gitkeep
!outputs/runs/
!outputs/tables/
!outputs/predictions/
outputs/runs/*
outputs/tables/*
outputs/predictions/*
!outputs/runs/.gitkeep
!outputs/tables/.gitkeep
!outputs/predictions/.gitkeep


# =========================================================
# Inventários locais de auditoria e contexto (gerados por
# `tools/collect_repo_context.py` e
# `tools/update_project_reference.py`)
# =========================================================

/docs/ai_context/
/docs/PROJECT_COMPLETE_REFERENCE.md