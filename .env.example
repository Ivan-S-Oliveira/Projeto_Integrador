# Template de variáveis de ambiente do Projeto Integrador.
# Copie para .env e preencha os valores locais.
# O arquivo .env NÃO deve ser versionado.

# Token do GitHub (opcional, apenas se o repositório for privado)
GITHUB_TOKEN=

# URL do Parquet do SRAG 2019-2026 (opcional).
# Se não definido, o valor padrão em config.py é usado.
# Atualize conforme o portal: https://dadosabertos.saude.gov.br/dataset/srag-2019-a-2026
SRAG_PARQUET_URL=