      "\u001b[31mFileNotFoundError\u001b[39m                         Traceback (most recent call last)",
      "\u001b[36mCell\u001b[39m\u001b[36m \u001b[39m\u001b[32mIn[2]\u001b[39m\u001b[32m, line 26\u001b[39m\n\u001b[32m     22\u001b[39m     )\n\u001b[32m     23\u001b[39m     encontrados_nomes = {Path(p).name \u001b[38;5;28;01mfor\u001b[39;00m p \u001b[38;5;28;01min\u001b[39;00m encontrados}\n\u001b[32m     24\u001b[39m     ausentes = sorted(nomes - encontrados_nomes)\n\u001b[32m     25\u001b[39m \n\u001b[32m---> \u001b[39m\u001b[32m26\u001b[39m     raise FileNotFoundError(\n\u001b[32m     27\u001b[39m         \u001b[33m\"O artefato supervisionado está incompleto. \"\u001b[39m\n\u001b[32m     28\u001b[39m         f\"Arquivos ausentes: {ausentes}. \"\n\u001b[32m     29\u001b[39m         \u001b[33m\"Execute o Notebook 03 adaptado para gerar o \"\u001b[39m\n",
